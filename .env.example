# =================================================================
# 🎓 Academix-Sender: 保研/考研联系导师自荐信个性化自动发送工具配置模版
# =================================================================
# 使用方法: 复制本文件并重命名为 .env，然后将对应配置填入下方。

# 🤖 DeepSeek 大模型配置 (获取地址: https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_API_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ✉️ 发信人 SMTP 邮箱服务配置 (以 163 邮箱或 QQ 邮箱为例)
# SMTP_SERVER: 网易为 smtp.163.com，QQ为 smtp.qq.com
SMTP_SERVER=smtp.163.com
SMTP_PORT=465
# SMTP_USER: 您的发信邮箱完整账号
SMTP_USER=your_email@163.com
# SMTP_PASS: 您的邮箱 SMTP 独立授权码 (注意不是您的邮箱登录密码，需在邮箱设置中开启 SMTP 开启并获取)
SMTP_PASS=your_smtp_authorization_code_here

# 👤 发件人个人信息 (用于自动替换自荐信中的签名、邮件发件人别名和自适应邮件标题)
SENDER_NAME=张三
SENDER_UNIVERSITY=某某大学
EMAIL_SUBJECT=预推免自荐信-{SENDER_UNIVERSITY}-{SENDER_NAME}

# 📁 默认简历 PDF 附件路径 (可将您的简历 PDF 放入项目同目录下，并在此填入文件名)
DEFAULT_ATTACHMENT_PATH=resume.pdf
